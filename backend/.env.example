SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://<supabase-pooler-host>:5432/<database>?sslmode=require
DB_USERNAME=<application-role>.<project-ref>
DB_PASSWORD=<application-role-password>
DB_MAX_POOL_SIZE=5
REDIS_URL=rediss://<managed-redis-connection-string>
AI_PROVIDER=groq
GROQ_API_KEY=<groq-api-key>
GROQ_MODEL=openai/gpt-oss-20b
JWT_SECRET=<base64-encoded-32-byte-or-longer-secret>
JWT_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=1209600000
CORS_ALLOWED_ORIGINS=https://<vercel-production-domain>
SPRINGDOC_ENABLED=false
